//@version=6
// =============================================================================
// MECH LIVE — alertes temps réel sur NQ futures
// =============================================================================
// Portage fidèle de scripts/mech.js, avec la configuration mesurée dans
// scripts/REGLAGES.md :
//
//   64 trades · 84,4 % de réussite · espérance +0,237 R · profit factor 2,49
//   drawdown maximal 2,25 R · NQ seul · 09h30–10h00 New York · bougies 5 min
//
// RÉSERVE, à lire avant de s'en servir : ce réglage est le meilleur de 263
// essais menés sur la même période de 60 jours. Il tient sur deux blocs de
// 30 jours (83,3 % puis 85,0 %) et résiste au déplacement de ses paramètres,
// mais il ne transfère ni à l'ES ni à une autre unité d'exécution. L'avantage
// réel est probablement plus proche de +0,10 R que de +0,237 R.
//
// CHAÎNE :  BIAIS HTF → DOL → NIVEAU CLÉ → TOUCHE → IFVG → CLÔTURE DE CORPS
//           → ENTRÉE → stop au bord de l'IFVG → 1/2 R partiel puis runner
//
// UTILISATION
//   1. Graphique NQ1! (ou NQZ2026) en 5 minutes, fuseau New York.
//   2. Ajouter l'indicateur.
//   3. Alertes → Créer une alerte → Condition : cet indicateur → « Signal MECH »
//      → Notifier sur l'application mobile.
//   Les données NQ en temps réel exigent l'abonnement CME Level 1 de TradingView.
// =============================================================================

indicator("MECH Live — alertes NQ", "MECH", overlay = true,
     max_boxes_count = 200, max_lines_count = 200, max_labels_count = 100)

// ============================ PARAMÈTRES =====================================
g1 = "Séance"
hDeb   = input.int(930,  "Début (HHMM, New York)", group = g1)
hFin   = input.int(1000, "Fin   (HHMM, New York)", group = g1)
maxJ   = input.int(2,    "Signaux maximum par jour", minval = 1, group = g1)

g2 = "Biais haute unité"
seuilB = input.int(2, "Score minimum (sur 4)", minval = 1, maxval = 4, group = g2,
     tooltip = "Chaque unité — D, 4H, 1H, 15M — vote +1, 0 ou -1 selon que ses FVG " +
               "sont respectés ou non. En dessous du seuil le biais est NEUTRE et " +
               "aucune position n'est prise. Valeur par défaut de la référence : 2.")

g3 = "Niveaux clés"
useFVG  = input.bool(true, "FVG",             group = g3)
useITL  = input.bool(true, "ITL / ITH",       group = g3)
useCISD = input.bool(true, "CISD",            group = g3)
useRB   = input.bool(true, "Rejection Block", group = g3)
keyAge  = input.int(400, "Âge maximum (bougies)", group = g3)

g4 = "Entrée et sortie"
tp1R   = input.float(0.5, "Partiel à (R)",        step = 0.1, group = g4)
partP  = input.float(90,  "Fraction encaissée %", step = 5,   group = g4)
tp2R   = input.float(2.5, "Runner jusqu'à (R)",   step = 0.1, group = g4)
bufPc  = input.float(0.02,"Tampon du stop (% du prix)", step = 0.01, group = g4)
atrMin = input.float(0.3, "Stop minimum (× ATR)", step = 0.1, group = g4)
reactN = input.int(12, "Bougies max entre touche et IFVG", group = g4)

g5 = "Affichage"
showZones = input.bool(true, "Dessiner les zones", group = g5)
showDOL   = input.bool(true, "Tracer le DOL",      group = g5)

// ============================ HORAIRES =======================================
minNY = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
dNY   = dayofweek(time, "America/New_York")
hhmm(v) => math.floor(v / 100) * 60 + (v % 100)
dansFenetre = dNY != dayofweek.saturday and dNY != dayofweek.sunday and
     minNY >= hhmm(hDeb) and minNY < hhmm(hFin)

// ============================ BIAIS HTF ======================================
// Un FVG est RESPECTÉ quand le prix y entre et en ressort du bon côté sans
// qu'une bougie clôture au-delà ; NON RESPECTÉ dès qu'une clôture le traverse.
// Contribution : haussier respecté +1, haussier non respecté -1, et miroir.
// [Ces deux définitions sont de nous : la source emploie les mots sans les
//  définir. Elles sont mécaniques, donc testables.]
voteTF() =>
    var float zHaut = na
    var float zBas  = na
    var bool  zUp   = na
    var int   v     = 0
    // dernier FVG formé
    if low > high[2]
        zBas := high[2], zHaut := low, zUp := true
    else if high < low[2]
        zBas := high, zHaut := low[2], zUp := false
    if not na(zHaut)
        if zUp and close < zBas
            v := -1
            zHaut := na
        else if not zUp and close > zHaut
            v := 1
            zHaut := na
        else if low <= zHaut and high >= zBas
            v := zUp ? 1 : -1
    v

vD  = request.security(syminfo.tickerid, "D",   voteTF(), lookahead = barmerge.lookahead_off)
v4H = request.security(syminfo.tickerid, "240", voteTF(), lookahead = barmerge.lookahead_off)
v1H = request.security(syminfo.tickerid, "60",  voteTF(), lookahead = barmerge.lookahead_off)
v15 = request.security(syminfo.tickerid, "15",  voteTF(), lookahead = barmerge.lookahead_off)
score = nz(vD) + nz(v4H) + nz(v1H) + nz(v15)
biais = score >= seuilB ? 1 : score <= -seuilB ? -1 : 0

// ============================ DOL ============================================
// La liquidité intacte LA PLUS PROCHE dans le sens du biais, sur 1 heure.
// La plus proche, et non la plus ancienne : c'est ce que le prix peut aller
// chercher dans la séance. Un swing 1H vieux de trois mois est à plus de
// mille points et ne sert à rien comme objectif.
dolH() =>
    ph = ta.pivothigh(high, 2, 2)
    var float niv = na
    if not na(ph)
        niv := ph
    if not na(niv) and high > niv
        niv := na
    niv
dolB() =>
    pl = ta.pivotlow(low, 2, 2)
    var float niv = na
    if not na(pl)
        niv := pl
    if not na(niv) and low < niv
        niv := na
    niv
dolHaut = request.security(syminfo.tickerid, "60", dolH(), lookahead = barmerge.lookahead_off)
dolBas  = request.security(syminfo.tickerid, "60", dolB(), lookahead = barmerge.lookahead_off)
dol     = biais > 0 ? dolHaut : dolBas
dolLibre = not na(dol) and (biais > 0 ? close < dol : close > dol)

// ============================ NIVEAUX CLÉS ===================================
// Quatre familles. Chaque zone est gardée tant qu'aucune clôture ne la traverse
// du côté opposé.
type Zone
    float haut
    float bas
    bool  up
    int   ne
    string nom

var array<Zone> zones = array.new<Zone>()

ajoute(float h, float b, bool up, string nom) =>
    if not na(h) and not na(b) and h > b
        array.push(zones, Zone.new(h, b, up, bar_index, nom))
        if array.size(zones) > 120
            array.shift(zones)

// FVG — motif à 3 bougies dont les mèches 1 et 3 ne se chevauchent pas  [ICT]
if useFVG and low > high[2]
    ajoute(low, high[2], true, "FVG")
if useFVG and high < low[2]
    ajoute(high, low[2], false, "FVG")

// ITL / ITH — hiérarchie fractale d'ICT : un STL encadré de STL plus hauts.
// Approché ici par un pivot de rang 2, le plus proche équivalent disponible
// en Pine sans reconstruire toute la hiérarchie.  [approximation assumée]
pL = ta.pivotlow(low, 2, 2)
pH = ta.pivothigh(high, 2, 2)
if useITL and not na(pL)
    ajoute(high[2], pL, true, "ITL")
if useITL and not na(pH)
    ajoute(pH, low[2], false, "ITH")

// CISD — clôture au-delà de l'open de la dernière série de bougies opposées
// qui a produit l'extrême.  [notre définition : la source cite le sigle sans
// le définir]
var int serieB = 0
var int serieH = 0
serieB := close < open ? serieB + 1 : 0
serieH := close > open ? serieH + 1 : 0
if useCISD and serieB[1] >= 2 and close > open[serieB[1]]
    ajoute(open[serieB[1]], ta.lowest(low, serieB[1] + 1), true, "CISD")
if useCISD and serieH[1] >= 2 and close < open[serieH[1]]
    ajoute(ta.highest(high, serieH[1] + 1), open[serieH[1]], false, "CISD")

// Rejection Block — la MÈCHE, non le corps, de la bougie qui marque un extrême
// rejeté.  [notre définition, même réserve]
rng   = high - low
corpsH = math.max(open, close)
corpsB = math.min(open, close)
if useRB and rng > 0 and (corpsB - low) / rng >= 0.5 and low < low[1] and low < low[2]
    ajoute(corpsB, low, true, "RB")
if useRB and rng > 0 and (high - corpsH) / rng >= 0.5 and high > high[1] and high > high[2]
    ajoute(corpsH, high, false, "RB")

// ============================ MACHINE À ÉTATS ================================
// 0 = cherche un niveau · 1 = attend la touche · 2 = attend l'IFVG
var int    etat    = 0
var float  kHaut   = na
var float  kBas    = na
var string kNom    = ""
var int    legDeb  = 0
var int    nJour   = 0
var bool   pos     = false
var float  entree  = na
var float  stop    = na
var float  cible1  = na
var float  cible2  = na
var bool   part1   = false
var float  risque  = na

nouveauJour = ta.change(time("D")) != 0
if nouveauJour
    nJour := 0
    etat  := 0

atrV = ta.atr(14)

// suivi de la position ouverte
if pos
    if not part1 and (cible1 > entree ? high >= cible1 : low <= cible1)
        part1 := true
        stop  := entree
    if part1 and (cible2 > entree ? high >= cible2 : low <= cible2)
        pos := false
    else if (cible1 > entree ? low <= stop : high >= stop)
        pos := false

// ---- 1. biais et DOL --------------------------------------------------------
actif = dansFenetre and biais != 0 and dolLibre and nJour < maxJ and not pos

// ---- 2. niveau clé ----------------------------------------------------------
if actif and etat == 0
    float meilleurD = na
    for i = 0 to array.size(zones) - 1
        z = array.get(zones, i)
        if bar_index - z.ne <= keyAge and z.up == (biais > 0)
            invalide = biais > 0 ? close < z.bas : close > z.haut
            if not invalide
                d = biais > 0 ? close - z.haut : z.bas - close
                if d >= 0 and (na(meilleurD) or d < meilleurD)
                    meilleurD := d
                    kHaut := z.haut
                    kBas  := z.bas
                    kNom  := z.nom
    if not na(meilleurD)
        etat := 1

// ---- 3. la touche -----------------------------------------------------------
if actif and etat == 1 and not na(kHaut)
    if low <= kHaut and high >= kBas
        etat   := 2
        legDeb := bar_index
    else if biais > 0 ? close < kBas : close > kHaut
        etat  := 0
        kHaut := na

// ---- 4. l'IFVG, validé par CLÔTURE DE CORPS --------------------------------
// Un FVG cassé par une clôture de corps donne l'inversion de sens opposé.
// Le simple contact ne déclenche rien.
var float ifHaut = na
var float ifBas  = na
ifvgOK = false
if actif and etat == 2
    if bar_index - legDeb > reactN
        etat  := 0
        kHaut := na
    else
        for i = math.max(0, array.size(zones) - 40) to array.size(zones) - 1
            z = array.get(zones, i)
            if z.nom == "FVG" and z.ne > legDeb - 20
                casseHaut = not z.up and close > z.haut          // baissier cassé = inversion haussière
                casseBas  = z.up and close < z.bas
                if (biais > 0 and casseHaut) or (biais < 0 and casseBas)
                    ifHaut := z.haut
                    ifBas  := z.bas
                    ifvgOK := true

// ---- 5. entrée --------------------------------------------------------------
sigLong  = ifvgOK and biais > 0 and barstate.isconfirmed
sigShort = ifvgOK and biais < 0 and barstate.isconfirmed

if (sigLong or sigShort) and not pos
    L   = sigLong
    buf = close * bufPc / 100
    st  = L ? ifBas - buf : ifHaut + buf
    rq  = math.abs(close - st)
    if rq > 0 and rq >= atrV * atrMin
        entree := close
        stop   := st
        risque := rq
        cible1 := L ? close + rq * tp1R : close - rq * tp1R
        cible2 := L ? close + rq * tp2R : close - rq * tp2R
        part1  := false
        pos    := true
        nJour  += 1
        etat   := 0
        kHaut  := na

// ============================ AFFICHAGE ======================================
plotshape(pos and ta.change(nz(entree)) != 0 and entree > stop, "Long",
     shape.triangleup, location.belowbar, color.new(color.teal, 0), size = size.small)
plotshape(pos and ta.change(nz(entree)) != 0 and entree < stop, "Short",
     shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)

plot(pos ? entree : na, "Entrée", color.new(color.blue, 0),  1, plot.style_linebr)
plot(pos ? stop   : na, "Stop",   color.new(color.red, 0),   1, plot.style_linebr)
plot(pos ? cible1 : na, "1/2 R",  color.new(color.teal, 40), 1, plot.style_linebr)
plot(pos ? cible2 : na, "Runner", color.new(color.teal, 0),  1, plot.style_linebr)
plot(showDOL and not na(dol) ? dol : na, "DOL", color.new(color.orange, 30), 2, plot.style_linebr)

bgcolor(dansFenetre ? color.new(color.blue, 94) : na, title = "Fenêtre de séance")

var table info = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "Biais",   text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 0, biais > 0 ? "HAUSSIER " + str.tostring(score) : biais < 0 ? "BAISSIER " + str.tostring(score) : "NEUTRE " + str.tostring(score),
         text_color = biais > 0 ? color.teal : biais < 0 ? color.red : color.gray, text_size = size.small)
    table.cell(info, 0, 1, "Étape",   text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 1, etat == 0 ? "cherche un niveau" : etat == 1 ? "attend la touche" : "attend l'IFVG",
         text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Niveau",  text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 2, na(kHaut) ? "—" : kNom + " " + str.tostring(kBas, format.mintick) + " / " + str.tostring(kHaut, format.mintick),
         text_color = color.white, text_size = size.small)
    table.cell(info, 0, 3, "DOL",     text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 3, na(dol) ? "—" : str.tostring(dol, format.mintick), text_color = color.orange, text_size = size.small)
    table.cell(info, 0, 4, "Signaux du jour", text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 4, str.tostring(nJour) + " / " + str.tostring(maxJ), text_color = color.white, text_size = size.small)

// ============================ ALERTES ========================================
alertcondition(sigLong,  "MECH LONG",  "MECH LONG {{ticker}} — entrée {{close}}")
alertcondition(sigShort, "MECH SHORT", "MECH SHORT {{ticker}} — entrée {{close}}")
alertcondition(sigLong or sigShort, "Signal MECH", "Signal MECH sur {{ticker}} à {{close}}")
