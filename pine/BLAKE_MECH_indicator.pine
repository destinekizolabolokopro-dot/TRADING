//@version=6
// =============================================================================
// BLAKE'S MECHANICAL MODEL — INDICATEUR (Pine v6)
// =============================================================================
// Fidèle à la spécification fournie par l'utilisateur :
//   LIQUIDITY SWEEP → STRUCTURE → INVERSION → FVG NON MITIGÉ → ENTRÉE
//   → 1R → BREAK-EVEN → FVG / LIQUIDITÉ EXTERNE
//
// POINTS CLÉS DE LA SPEC (respectés tels quels) :
//  • PAS de biais HTF obligatoire (le modèle marche même à l'ATH). La STRUCTURE prime.
//  • Ce sont les HIGHS/LOWS qui sont sweepés. Le FVG n'est PAS la liquidité :
//    c'est le DRAW / la CIBLE après l'inversion.
//  • Séquence LONG  : Swing Low → Swing High → LOWER LOW qui sweep une liquidité.
//    Séquence SHORT : Swing High → Swing Low → HIGHER HIGH qui sweep une liquidité.
//  • On n'entre PAS au sweep : Sweep → INVERSION → Entrée.
//  • La cible est choisie AVANT l'entrée (FVG non mitigé le plus proche = internal draw).
//  • À +1R : SL → Entry (break-even). Puis runner vers la liquidité externe.
//  • SMT à contre-sens = NO TRADE (version mécanique, sans exception).
//  • Macros : 09:30–11:00 et 13:00–15:00 EST. On évite le lunch.
//
// ⚠️ DEUX NOTIONS NON UNIVERSELLES (signalées par l'utilisateur) :
//    "INVERSION" et "SMT" n'ont pas de définition unique. Elles sont donc
//    FORMALISÉES ICI EN MODES SÉLECTIONNABLES, pour être testés SÉPARÉMENT.
//    Aucune n'est présentée comme "la" définition officielle.
// =============================================================================

indicator("Blake Mech Model — Indicateur", "MECH", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================== PARAMÈTRES ===================================
gStruct = "① Structure & liquidité"
pivLen    = input.int(5, "Longueur des pivots (swings)", minval = 2, group = gStruct,
     tooltip = "Un swing est confirmé après ce nombre de bougies de chaque côté (non-repaint).")
sweepTolPct = input.float(0.0, "Tolérance de sweep (%)", minval = 0.0, step = 0.01, group = gStruct,
     tooltip = "0 = il faut dépasser strictement le niveau. >0 tolère un quasi-sweep.")
setupExpiry = input.int(30, "Validité du setup après le sweep (bougies)", minval = 3, group = gStruct)
eqTolPct    = input.float(0.05, "Tolérance Equal High/Low (%)", minval = 0.0, step = 0.01, group = gStruct)

gLiq = "② Sources de liquidité (ce qui est sweepé)"
usePDHL   = input.bool(true, "Previous Day High / Low",  group = gLiq)
useSess   = input.bool(true, "Highs / Lows de session",  group = gLiq)
useSwings = input.bool(true, "Swing Highs / Lows",       group = gLiq)
useEqual  = input.bool(true, "Equal Highs / Lows",       group = gLiq)
showLiq   = input.bool(true, "Afficher les niveaux",     group = gLiq)

gSess = "③ Sessions & macros (EST)"
tz       = input.string("America/New_York", "Fuseau horaire", group = gSess)
asiaSess = input.session("2000-0000", "Asie",    group = gSess)
lonSess  = input.session("0300-0600", "Londres", group = gSess)
amSess   = input.session("0930-1100", "AM (NY)", group = gSess)
macro1   = input.session("0930-1100", "Macro 1 — fenêtre de trade", group = gSess)
macro2   = input.session("1300-1500", "Macro 2 — fenêtre de trade", group = gSess)
useWallSt  = input.bool(true, "Filtrer par les fenêtres de trading", group = gSess,
     tooltip = "Deux créneaux : ouverture de Wall Street → 17 h 00 (Paris), et 19 h 00 → 21 h 00 (Paris). Les deux fuseaux sont lus séparément : la France et les USA ne changent pas d'heure les mêmes semaines, donc l'ouverture tombe à 14 h 30 ou 15 h 30 à Paris selon la période. Le filtre reste juste toute l'année.")
nyOpenSess = input.session("0930-1600", "Séance New York (fuseau NY)", group = gSess)
parisCut   = input.session("0000-1700", "Fenêtre 1 — coupure (fuseau Paris)", group = gSess)
parisSoir  = input.session("1900-2100", "Fenêtre 2 — soirée (fuseau Paris)", group = gSess)
useMacro = input.bool(true, "N'autoriser les entrées que dans les macros (évite le lunch)", group = gSess)

gInv = "④ INVERSION — à tester séparément"
invMode = input.string("CISD (clôture au-delà des opens)", "Définition de l'inversion",
     options = ["CISD (clôture au-delà des opens)", "MSS (cassure du dernier swing)", "Engulfing + displacement", "Création d'un FVG"],
     group = gInv, tooltip = "Aucune définition universelle : teste chaque mode séparément en backtest.")
dispMult = input.float(1.0, "Displacement : corps > ATR(14) ×", minval = 0.1, step = 0.1, group = gInv)
cisdLook = input.int(5, "CISD : nb de bougies opposées à dépasser", minval = 1, group = gInv)

gFvg = "⑤ FVG (la CIBLE / draw, pas la liquidité)"
fvgMinPct = input.float(0.02, "Taille minimale du FVG (%)", minval = 0.0, step = 0.01, group = gFvg)
fvgMaxAge = input.int(300, "Âge maximum d'un FVG (bougies)", minval = 10, group = gFvg)
mitigMode = input.string("Partielle (au 1er contact)", "Mitigation", options = ["Partielle (au 1er contact)", "Complète (gap rempli)"], group = gFvg)
showFvg   = input.bool(true, "Afficher les FVG non mitigés", group = gFvg)

gSMT = "⑥ SMT — à tester séparément"
useSMT   = input.bool(true, "Filtre SMT actif (contre-sens = NO TRADE)", group = gSMT)
smtSym   = input.symbol("CME_MINI:ES1!", "Actif corrélé", group = gSMT,
     tooltip = "Pour le NQ, la référence est le S&P 500 (ES). Aucune définition universelle : paramètre documenté.")
smtLen   = input.int(20, "Fenêtre SMT (bougies)", minval = 5, group = gSMT)

gRisk = "⑦ Risque & gestion"
slBufPct   = input.float(0.02, "Buffer du SL (%)", minval = 0.0, step = 0.01, group = gRisk)
minRR      = input.float(1.0, "RR minimum pour valider", minval = 0.1, step = 0.1, group = gRisk)
beAtR      = input.float(1.0, "Break-even à (R)", minval = 0.1, step = 0.1, group = gRisk)
useBE      = input.bool(true, "Break-even activé", group = gRisk)
equityIn   = input.float(10000, "Capital ($)", minval = 1, group = gRisk)
riskPct    = input.float(1.0, "Risque par trade (%)", minval = 0.01, step = 0.05, group = gRisk)
maxTrades  = input.int(3, "Trades max / jour", minval = 1, group = gRisk)
maxLosses  = input.int(2, "Pertes max / jour", minval = 1, group = gRisk)

gUI = "⑧ Affichage"
showTable = input.bool(true, "Tableau de bord", group = gUI)

// ============================== OUTILS =======================================
atr14 = ta.atr(14)
inSess(s) => not na(time(timeframe.period, s, tz))
inAsia = inSess(asiaSess)
inLon  = inSess(lonSess)
inAM   = inSess(amSess)
inMacro = inSess(macro1) or inSess(macro2)
inNYopen     = not na(time(timeframe.period, nyOpenSess, "America/New_York"))
inParisCut   = not na(time(timeframe.period, parisCut,   "Europe/Paris"))
inParisSoir  = not na(time(timeframe.period, parisSoir,  "Europe/Paris"))
// Fenêtre 1 : de l'ouverture de New York jusqu'à 17 h à Paris.
// Fenêtre 2 : 19 h → 21 h à Paris, soit la macro de l'après-midi à New York.
inWallWindow = (inNYopen and inParisCut) or inParisSoir

// --- Extrêmes de session (reset au début de chaque session)
var float asiaH = na, asiaL = na, lonH = na, lonL = na, amH = na, amL = na
if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
else if inAsia
    asiaH := math.max(nz(asiaH, high), high)
    asiaL := math.min(nz(asiaL, low), low)
if inLon and not inLon[1]
    lonH := high
    lonL := low
else if inLon
    lonH := math.max(nz(lonH, high), high)
    lonL := math.min(nz(lonL, low), low)
if inAM and not inAM[1]
    amH := high
    amL := low
else if inAM
    amH := math.max(nz(amH, high), high)
    amL := math.min(nz(amL, low), low)

// --- PDH / PDL : jour PRÉCÉDENT, donc figé (anti-repaint)
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)

// --- Swings confirmés (décalés de pivLen : jamais devinés à l'avance)
phv = ta.pivothigh(high, pivLen, pivLen)
plv = ta.pivotlow(low,  pivLen, pivLen)
var float sH1 = na, sH2 = na      // derniers swing highs (1 = le plus récent)
var float sL1 = na, sL2 = na      // derniers swing lows
var int   sH1b = na, sL1b = na
if not na(phv)
    sH2 := sH1
    sH1 := phv
    sH1b := bar_index - pivLen
if not na(plv)
    sL2 := sL1
    sL1 := plv
    sL1b := bar_index - pivLen

eqTolAbs = close * eqTolPct / 100.0
hasEqH = not na(sH1) and not na(sH2) and math.abs(sH1 - sH2) <= eqTolAbs
hasEqL = not na(sL1) and not na(sL2) and math.abs(sL1 - sL2) <= eqTolAbs

// ============================== FVG (CIBLES) =================================
type Fvg
    float top
    float bot
    bool  bull
    int   born
    bool  active

var array<Fvg> fvgs = array.new<Fvg>()
fvgMinAbs = close * fvgMinPct / 100.0
newBullFvg = low > high[2] and (low - high[2]) >= fvgMinAbs
newBearFvg = high < low[2] and (low[2] - high) >= fvgMinAbs

if barstate.isconfirmed
    if newBullFvg
        array.push(fvgs, Fvg.new(low, high[2], true, bar_index, true))
    if newBearFvg
        array.push(fvgs, Fvg.new(low[2], high, false, bar_index, true))

// Mitigation : un FVG mitigé n'est plus une cible valide (règle de la spec)
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        if f.active
            touched = low <= f.top and high >= f.bot
            filled  = f.bull ? low <= f.bot : high >= f.top
            if (mitigMode == "Complète (gap rempli)" ? filled : touched)
                f.active := false
            if bar_index - f.born > fvgMaxAge
                f.active := false
            array.set(fvgs, i, f)

// Cible = FVG non mitigé le PLUS PROCHE dans la direction du trade (internal draw)
f_drawAbove() =>
    float best = na
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            f = array.get(fvgs, i)
            if f.active
                mid = (f.top + f.bot) / 2.0
                if mid > close and (na(best) or mid < best)
                    best := mid
    best
f_drawBelow() =>
    float best = na
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            f = array.get(fvgs, i)
            if f.active
                mid = (f.top + f.bot) / 2.0
                if mid < close and (na(best) or mid > best)
                    best := mid
    best

drawUp   = f_drawAbove()   // cible d'un LONG
drawDown = f_drawBelow()   // cible d'un SHORT

// Liquidité externe (runner)
extUp   = na(pdh) ? sH1 : math.max(nz(pdh, sH1), nz(sH1, pdh))
extDown = na(pdl) ? sL1 : math.min(nz(pdl, sL1), nz(sL1, pdl))

// ============================== SWEEP DE LIQUIDITÉ ===========================
tolAbs = close * sweepTolPct / 100.0
// Le LOW de la bougie est-il allé chercher une liquidité SOUS le marché ?
f_tookLiqBelow(float px) =>
    bool hit = false
    if usePDHL and not na(pdl) and px <= pdl + tolAbs
        hit := true
    if useSess and ((not na(asiaL) and px <= asiaL + tolAbs) or (not na(lonL) and px <= lonL + tolAbs) or (not na(amL) and px <= amL + tolAbs))
        hit := true
    if useSwings and not na(sL2) and px <= sL2 + tolAbs
        hit := true
    if useEqual and hasEqL and not na(sL1) and px <= sL1 + tolAbs
        hit := true
    hit
f_tookLiqAbove(float px) =>
    bool hit = false
    if usePDHL and not na(pdh) and px >= pdh - tolAbs
        hit := true
    if useSess and ((not na(asiaH) and px >= asiaH - tolAbs) or (not na(lonH) and px >= lonH - tolAbs) or (not na(amH) and px >= amH - tolAbs))
        hit := true
    if useSwings and not na(sH2) and px >= sH2 - tolAbs
        hit := true
    if useEqual and hasEqH and not na(sH1) and px >= sH1 - tolAbs
        hit := true
    hit

// ====================== STRUCTURE DU SETUP (spec §2) =========================
// LONG  : Swing Low → Swing High → LOWER LOW qui sweep une liquidité
// SHORT : Swing High → Swing Low → HIGHER HIGH qui sweep une liquidité
var bool  longArmed  = false, shortArmed = false
var float sweepLow   = na,    sweepHigh  = na
var int   armedBar   = na

// Nouveau swing LOW confirmé : est-ce un LOWER LOW qui prend de la liquidité ?
if not na(plv)
    isLowerLow = not na(sL2) and plv < sL2
    if isLowerLow and f_tookLiqBelow(plv) and not na(sH1)
        longArmed  := true
        shortArmed := false
        sweepLow   := plv
        armedBar   := bar_index
// Nouveau swing HIGH confirmé : est-ce un HIGHER HIGH qui prend de la liquidité ?
if not na(phv)
    isHigherHigh = not na(sH2) and phv > sH2
    if isHigherHigh and f_tookLiqAbove(phv) and not na(sL1)
        shortArmed := true
        longArmed  := false
        sweepHigh  := phv
        armedBar   := bar_index

// Expiration du setup
if not na(armedBar) and bar_index - armedBar > setupExpiry
    longArmed  := false
    shortArmed := false

// ====================== INVERSION (formalisée, §3) ===========================
// ⚠️ 4 définitions au choix — À TESTER SÉPARÉMENT (aucune n'est "officielle").
body       = math.abs(close - open)
hasDisp    = body > atr14 * dispMult
highestOpen = ta.highest(open, cisdLook)
lowestOpen  = ta.lowest(open,  cisdLook)

invBull = switch invMode
    "CISD (clôture au-delà des opens)" => close > highestOpen[1] and close > open
    "MSS (cassure du dernier swing)"   => not na(sH1) and close > sH1
    "Engulfing + displacement"         => close > open and close > high[1] and hasDisp
    => newBullFvg                       // "Création d'un FVG"

invBear = switch invMode
    "CISD (clôture au-delà des opens)" => close < lowestOpen[1] and close < open
    "MSS (cassure du dernier swing)"   => not na(sL1) and close < sL1
    "Engulfing + displacement"         => close < open and close < low[1] and hasDisp
    => newBearFvg

// ====================== SMT (formalisé, §11) =================================
// ⚠️ Définition non universelle : divergence des extrêmes vs actif corrélé.
corrH = request.security(smtSym, timeframe.period, high, lookahead = barmerge.lookahead_off)
corrL = request.security(smtSym, timeframe.period, low,  lookahead = barmerge.lookahead_off)
selfHH = high >= ta.highest(high, smtLen)
selfLL = low  <= ta.lowest(low,  smtLen)
corrHH = not na(corrH) and corrH >= ta.highest(corrH, smtLen)
corrLL = not na(corrL) and corrL <= ta.lowest(corrL, smtLen)
smtBear = selfHH and not corrHH      // divergence baissière -> interdit d'acheter
smtBull = selfLL and not corrLL      // divergence haussière -> interdit de vendre
blockLong  = useSMT and smtBear
blockShort = useSMT and smtBull

// ====================== LIMITES JOURNALIÈRES =================================
var int tradesToday = 0, lossesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0
    lossesToday := 0
limitOK = tradesToday < maxTrades and lossesToday < maxLosses

// ====================== CONDITIONS FINALES (§16-17) ==========================
macroOK = (not useMacro or inMacro) and (not useWallSt or inWallWindow)
buf = close * slBufPct / 100.0

longSL  = nz(sweepLow, low) - buf
shortSL = nz(sweepHigh, high) + buf
longRisk  = close - longSL
shortRisk = shortSL - close
longRR  = longRisk  > 0 and not na(drawUp)   ? (drawUp - close)   / longRisk  : 0.0
shortRR = shortRisk > 0 and not na(drawDown) ? (close - drawDown) / shortRisk : 0.0

VALID_LONG  = longArmed  and invBull and not na(drawUp)   and not blockLong  and macroOK and limitOK and longRR  >= minRR
VALID_SHORT = shortArmed and invBear and not na(drawDown) and not blockShort and macroOK and limitOK and shortRR >= minRR

// Raison de non-trade (§21)
NO_TRADE_REASON = not (longArmed or shortArmed) ? "Pas de structure + sweep" :
     not (invBull or invBear) ? "Pas d'inversion confirmée" :
     (longArmed and na(drawUp)) or (shortArmed and na(drawDown)) ? "Aucun FVG non mitigé comme cible" :
     (blockLong or blockShort) ? "SMT à contre-sens" :
     not (not useWallSt or inWallWindow) ? "Hors fenêtres (WS→17 h / 19 h→21 h Paris)" :
     not macroOK ? "Hors fenêtre macro" :
     not limitOK ? "Limite journalière atteinte" :
     (longArmed and longRR < minRR) or (shortArmed and shortRR < minRR) ? "RR insuffisant" : "OK"

// ====================== GESTION DU TRADE =====================================
var bool  inPos = false, isLong = false, beDone = false
var float ePx = na, eSL = na, eSL0 = na, eTP = na, eRunner = na

if (VALID_LONG or VALID_SHORT) and not inPos
    isLong  := VALID_LONG
    ePx     := close
    eSL     := isLong ? longSL : shortSL
    eSL0    := eSL
    eTP     := isLong ? drawUp : drawDown
    eRunner := isLong ? extUp : extDown
    beDone  := false
    inPos   := true
    longArmed  := false
    shortArmed := false
    tradesToday += 1

if inPos
    r0 = math.abs(ePx - eSL0)
    if useBE and not beDone and r0 > 0
        reached = isLong ? high >= ePx + r0 * beAtR : low <= ePx - r0 * beAtR
        if reached
            eSL := ePx          // §9 : SL -> Entry à 1R
            beDone := true
    hitSL = isLong ? low <= eSL : high >= eSL
    hitTP = isLong ? high >= eTP : low <= eTP
    if hitSL
        if eSL != ePx
            lossesToday += 1
        inPos := false
    else if hitTP
        inPos := false

riskAmt  = equityIn * riskPct / 100.0
stopDist = math.abs(nz(ePx, close) - nz(eSL0, close))
posSize  = stopDist > 0 ? riskAmt / stopDist : 0.0

// ====================== AFFICHAGE ============================================
plot(showLiq ? pdh : na, "PDH", color.new(color.orange, 0), 1, plot.style_linebr)
plot(showLiq ? pdl : na, "PDL", color.new(color.orange, 0), 1, plot.style_linebr)
plot(showLiq ? asiaH : na, "Asia H", color.new(color.teal, 30), 1, plot.style_linebr)
plot(showLiq ? asiaL : na, "Asia L", color.new(color.teal, 30), 1, plot.style_linebr)
plot(showLiq ? lonH : na, "London H", color.new(color.purple, 30), 1, plot.style_linebr)
plot(showLiq ? lonL : na, "London L", color.new(color.purple, 30), 1, plot.style_linebr)

if showFvg and barstate.islast and array.size(fvgs) > 0
    for i = 0 to array.size(fvgs) - 1
        f = array.get(fvgs, i)
        if f.active
            box.new(f.born, f.top, bar_index + 3, f.bot,
                 border_color = color.new(f.bull ? color.green : color.red, 65),
                 bgcolor = color.new(f.bull ? color.green : color.red, 90))

plotshape(VALID_LONG,  "LONG",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "🟢 LONG",  textcolor = color.white, size = size.small)
plotshape(VALID_SHORT, "SHORT", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "🔴 SHORT", textcolor = color.white, size = size.small)
plotshape(longArmed  and not na(plv), "Sweep bas",  shape.triangleup,   location.belowbar, color.new(color.lime, 35),    size = size.tiny)
plotshape(shortArmed and not na(phv), "Sweep haut", shape.triangledown, location.abovebar, color.new(color.fuchsia, 35), size = size.tiny)

plot(inPos ? ePx : na, "Entrée", color.new(color.blue, 0),  1, plot.style_linebr)
plot(inPos ? eSL : na, "SL",     color.new(color.red, 0),   1, plot.style_linebr)
plot(inPos ? eTP : na, "TP",     color.new(color.green, 0), 1, plot.style_linebr)

ok(bool c) => c ? "✅" : "❌"
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 11, border_width = 1)
    table.cell(t, 0, 0,  "MECH",        bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(t, 1, 0,  inPos ? (isLong ? "LONG" : "SHORT") : "—", bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(t, 0, 1,  "Structure+Sweep"); table.cell(t, 1, 1, ok(longArmed or shortArmed))
    table.cell(t, 0, 2,  "Inversion");       table.cell(t, 1, 2, ok(invBull or invBear))
    table.cell(t, 0, 3,  "FVG cible");       table.cell(t, 1, 3, ok(not na(drawUp) or not na(drawDown)))
    table.cell(t, 0, 4,  "SMT OK");          table.cell(t, 1, 4, ok(not blockLong and not blockShort))
    table.cell(t, 0, 5,  "Macro");           table.cell(t, 1, 5, ok(macroOK))
    table.cell(t, 0, 6,  "RR");              table.cell(t, 1, 6, str.tostring(math.max(longRR, shortRR), "#.##"))
    table.cell(t, 0, 7,  "Entrée");          table.cell(t, 1, 7, inPos ? str.tostring(ePx, format.mintick) : "—")
    table.cell(t, 0, 8,  "SL");              table.cell(t, 1, 8, inPos ? str.tostring(eSL, format.mintick) + (beDone ? " (BE)" : "") : "—")
    table.cell(t, 0, 9,  "TP");              table.cell(t, 1, 9, inPos ? str.tostring(eTP, format.mintick) : "—")
    table.cell(t, 0, 10, "Statut");          table.cell(t, 1, 10, inPos ? "EN POSITION" : NO_TRADE_REASON)

// ====================== ALERTES ==============================================
alertcondition(VALID_LONG,  "MECH — ENTRÉE LONG",  "MECH : ENTRÉE LONG")
alertcondition(VALID_SHORT, "MECH — ENTRÉE SHORT", "MECH : ENTRÉE SHORT")
alertcondition(longArmed,   "MECH — Sweep bas (setup armé)",  "MECH : liquidité basse prise, on attend l'inversion")
alertcondition(shortArmed,  "MECH — Sweep haut (setup armé)", "MECH : liquidité haute prise, on attend l'inversion")
alertcondition(newBullFvg or newBearFvg, "MECH — Nouveau FVG", "MECH : nouveau FVG")

if VALID_LONG or VALID_SHORT
    alert(syminfo.ticker + " | " + (VALID_LONG ? "LONG" : "SHORT") + " | Entrée " + str.tostring(close, format.mintick) +
         " | SL " + str.tostring(VALID_LONG ? longSL : shortSL, format.mintick) +
         " | TP " + str.tostring(VALID_LONG ? drawUp : drawDown, format.mintick) +
         " | RR " + str.tostring(VALID_LONG ? longRR : shortRR, "#.##"), alert.freq_once_per_bar_close)

// ====================== ANTI-REPAINT (explication) ===========================
// 1) request.security(...) : lookahead = barmerge.lookahead_off partout.
// 2) PDH/PDL pris sur la veille ([1]) : valeur définitivement figée.
// 3) Les swings viennent de ta.pivothigh/pivotlow : confirmés seulement après
//    pivLen bougies -> jamais "devinés" puis retirés.
// 4) Les FVG ne sont enregistrés que sur barstate.isconfirmed.
// 5) Les alertes se déclenchent sur clôture (alert.freq_once_per_bar_close).
// => Ce que tu vois en replay = ce qui se serait produit en direct.
